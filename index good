<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAXIMUM REALITY</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        body { background-color: #000; margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: 'Press Start 2P', cursive; overflow: hidden; }
        
        .arcade-container { position: relative; width: 95vw; max-width: 800px; }
        
        .cabinet-shell { width: 100%; display: block; position: relative; z-index: 50; pointer-events: none; }

        /* SCREEN COORDINATES - Using your 11% fix */
        .screen {
            position: absolute;
            top: 36.2%; 
            left: 14.5%;    
            width: 71%; 
            height: 32.8%;
            background: #000; 
            overflow: hidden; 
            border-radius: 4px; 
            z-index: 100;
            border: 2px solid #39ff14;
            box-shadow: 0 0 15px #ff00ff inset;
            animation: pulseGreen 4s ease-in-out infinite alternate, pulseMagenta 4s ease-in-out infinite alternate 2s;
        }

        .intro-video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.9; z-index: 101; filter: contrast(1.2) brightness(1.1); }

        /* NEW: THE SCANLINE LAYER */
        .scanlines {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 3px 100%;
            z-index: 105;
            pointer-events: none;
            animation: crtFlicker 0.15s infinite;
        }

        @keyframes crtFlicker {
            0% { opacity: 0.97; }
            50% { opacity: 1; }
            100% { opacity: 0.98; }
        }

        /* BUTTONS */
        .button-container {
            position: absolute;
            bottom: 11%; left: 0; width: 100%; height: 80px;
            z-index: 200;
            pointer-events: none; 
        }

        .hotspot {
            position: absolute; width: 80px; height: 80px;
            background: transparent; 
            border-radius: 50%;
            pointer-events: auto; cursor: pointer;
            -webkit-tap-highlight-color: transparent; 
        }

        #unmute-btn { left: 24%; }
        #mute-btn { right: 18%; }

        .credits-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; z-index: 110; animation: scrollUp 15s linear infinite; }
        .arcade-link { 
    color: #ffffff; 
    text-decoration: none; 
    font-size: 0.45rem; 
    margin: 6px auto;   
    padding: 8px 10px; 
    text-align: center; 
    display: block; 
    width: 175px; 
    background: linear-gradient(135deg, #8b5cf6, #a855f7); 
    border-radius: 4px; 
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.6);
    transition: all 0.2s ease;
    text-transform: uppercase; /* Keeps the retro arcade vibe */
    letter-spacing: 1px;
}


        @keyframes pulseGreen { 0% { border-color:#39ff14; } 100% { border-color:#7fff3f; } }
        @keyframes pulseMagenta { 0% { box-shadow:0 0 15px #ff00ff inset; } 100% { box-shadow:0 0 30px #ff00ff inset; } }
        @keyframes scrollUp { 0% { transform: translateY(110%); } 100% { transform: translateY(-160%); } }
    </style>
</head>
<body>

<div class="arcade-container">
    <img src="arcade.PNG" class="cabinet-shell">
    
    <div class="button-container">
        <div id="unmute-btn" class="hotspot" onclick="toggleAudio(false)"></div>
        <div id="mute-btn" class="hotspot" onclick="toggleAudio(true)"></div>
    </div>

    <div class="screen">
    <video id="arcadeVideo" class="intro-video" autoplay muted loop playsinline>
        <source src="maximum_intro.mp4" type="video/mp4">
    </video>
    
    <div class="scanlines"></div>

    <div class="credits-container" style="animation: scrollUp 40s linear infinite;">
        <a href="https://youtube.com/@maximumrealitylori?si=HU87aBny8S9DV68d" target="_blank" class="arcade-link">1P: MAX REALITY TV</a>
        
        <a href="https://maximum-reality-shop.fourthwall.com/" target="_blank" class="arcade-link" style="background: linear-gradient(135deg, #ffcc00, #ff9900); box-shadow: 0 0 15px #ffcc00; color: #000; font-weight: bold;">SHOP: MERCH DROP</a>

        <a href="https://maximumreality.github.io/Abduction/" target="_blank" class="arcade-link">START: ABDUCTION</a>
        
        <a href="https://codepen.io/Acidic-Jellybean/pen/GgZLxBy" target="_blank" class="arcade-link">AZUL: WORD GUESS</a>
        <a href="https://maximumreality.github.io/azul-story-cyoa/" target="_blank" class="arcade-link">AZUL: CYOA STORY</a>
        
        <a href="https://maximumreality.github.io/Pulse/" target="_blank" class="arcade-link">BOOK: PULSE OF...</a>
        
        <a href="https://www.tiktok.com/@zer0chick?_r=1&_t=ZT-92Zb0VHWEsI" target="_blank" class="arcade-link">SOCIAL: TIKTOK</a>

        <a href="https://www.instagram.com/maximumrealitylori?igsh=OTY0c3pnOHp2dm9k&utm_source=qr" target="_blank" class="arcade-link">SOCIAL: INSTAGRAM</a>
    </div>
</div>

</div>

<script>
    function toggleAudio(isMute) {
        const video = document.getElementById('arcadeVideo');
        video.muted = isMute;
        video.play();
    }
</script>

</body>
</html>
